# Copy this file to .env for Docker Compose variable interpolation.
PETCARE_AI_ENABLED=false
PETCARE_AI_BASE_URL=
PETCARE_AI_MODEL=qwen3.7-plus
DASHSCOPE_API_KEY=

# The backend also reads these from the untracked .env.docker.local env file.
# Fill them locally; never put real credentials in this example file.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET_BASE64=
